#!/usr/bin/env bash
# Enemy v2 battler art in three steps.
#   scripts/imggen                       list concept ids (ENEMY_CONCEPTS) that have no v2 art yet
#   scripts/imggen ENEMY_ID 1 [POSE...]  generate poses from the image generator -> STAGE/ID/raw/
#                                        with POSE names: re-roll just those poses
#   scripts/imggen ENEMY_ID 2 [--force] [POSE...]
#                                        cutout -> accepted 1k cutouts in STAGE/ID/ID/, then 256px sheets
#                                        in STAGE/ID/sheets/ (review the result)
#                                        with POSE names (or ready): re-cut just those, reuse the other cutouts
#   scripts/imggen ENEMY_ID 2 pack       sheets only, from the existing 1k cutouts; nothing is re-cut
# Stage layout: STAGE/ID/{raw,cutouts,ID,sheets}/; ID/ holds only accepted cutouts (ready.png, ID-NN-<pose>.png),
# failed ones stay in cutouts/ next to their reports. Older stages are converted on the next run.
# Touch-ups: edit an accepted cutout in ID/ (or a failed one in cutouts/), then run step 2 pack.
# A cutout saved after its report is "touched up": step 2 accepts it even if its cut had failed,
# and never re-cuts it unless --force is given (a re-rolled jpg still marks it stale).
#   scripts/imggen ENEMY_ID 3            promote sheets into v2/ + ledger rows (no commit)
#   scripts/imggen ID1 ID2 ... STEP [ARGS] run STEP for each id in turn (same ARGS for each);
#                                        step 1 pauses ENEMY_GEN_DELAY between enemies; the first failure stops the batch
# Settings come from ~/.imggen.env (or the environment):
#   IMGGEN_STAGE   work area; each enemy gets STAGE/ID/
#   ENEMY_CONCEPTS concepts file (ID|description|keep-list|item per line); with no arguments, imggen lists its ids not yet in v2/
#   ENEMY_GEN_CMD  image generator, one image per call: $ENEMY_GEN_CMD OUT.jpg PROMPT_FILE [REF.jpg]
#                  no REF = new image; REF = edit seeded from it. Request settings arrive as env vars
#                  scoped to the call: GEN_MODEL GEN_RESOLUTION GEN_ASPECT GEN_QUALITY (may be empty).
#                  It must write a JPEG to OUT and exit non-zero on failure. Credentials are its own business;
#                  exit 3 means authentication recovery failed: no retry, the step (and a batch) stops.
#   ENEMY_GEN_MODEL model name handed to the generator as GEN_MODEL
#   ENEMY_GEN_DELAY seconds to wait after each generator call (requests run one at a time, for rate limits)
# Output of every step is also appended to STAGE/ID/raw/ID.log.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# config file supplies defaults; variables already set in the environment win
_env=(); for _v in IMGGEN_STAGE ENEMY_GEN_CMD ENEMY_GEN_MODEL ENEMY_GEN_DELAY ENEMY_CONCEPTS; do [ -n "${!_v:-}" ] && _env+=("$_v=${!_v}"); done
[ -f "$HOME/.imggen.env" ] && . "$HOME/.imggen.env"
for _v in "${_env[@]}"; do declare "$_v"; done
v2dir="$root/assets/scenarios/rusted_kingdoms/media/sprites/enemies/v2"
# no ID and no step: list the concept ids that have no v2 art yet
if [ $# -eq 0 ]; then
  concepts=${ENEMY_CONCEPTS:?set ENEMY_CONCEPTS in ~/.imggen.env}
  [ -f "$concepts" ] || { echo "no concepts file $concepts" >&2; exit 1; }
  todo=0; total=0
  while IFS='|' read -r cid _ || [ -n "$cid" ]; do
    case "$cid" in ''|'#'*) continue;; esac
    total=$((total+1))
    [ -e "$v2dir/$cid-status.png" ] || [ -e "$v2dir/$cid-attack.png" ] && continue
    todo=$((todo+1))
    note=; [ -n "${IMGGEN_STAGE:-}" ] && [ -d "$IMGGEN_STAGE/$cid" ] && note="  (in progress: $IMGGEN_STAGE/$cid)"
    echo "$cid$note"
  done < "$concepts"
  echo "-- $todo of $total concepts not yet in v2; start one: scripts/imggen ENEMY_ID 1" >&2
  exit 0
fi
# ENEMY_ID... STEP [ARGS]: every word before the step number is an enemy id
ids=()
while [ $# -gt 0 ] && ! [[ $1 =~ ^[123]$ ]]; do ids+=("$1"); shift; done
step=${1:-}
case "$step" in 1|2|3) ;; *) echo "usage: scripts/imggen ENEMY_ID [ENEMY_ID...] {1|2|3} [POSE...]   (1 generate, 2 cutout+sheets, 3 promote; no arguments: list ids still to do)" >&2; exit 2;; esac
[ ${#ids[@]} -gt 0 ] || { echo "missing ENEMY_ID" >&2; exit 2; }
shift
# several ids: run this script once per id, in order, with the same step and arguments.
# Step 1 waits ENEMY_GEN_DELAY between enemies (each run's first generator call does not wait on its own).
# The first failed enemy stops the batch, as does Ctrl-C.
if [ ${#ids[@]} -gt 1 ]; then
  if [ "$step" = 1 ]; then
    : "${ENEMY_GEN_DELAY:?set ENEMY_GEN_DELAY (seconds between generator calls) in ~/.imggen.env}"
    [[ $ENEMY_GEN_DELAY =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ENEMY_GEN_DELAY must be a number of seconds, got '$ENEMY_GEN_DELAY'" >&2; exit 1; }
  fi
  # shipped art is checked for every id up front, so a typo'd batch fails before any generator call
  if [ "$step" = 1 ]; then
    shipped=(); for id in "${ids[@]}"; do [ -e "$v2dir/$id-status.png" ] || [ -e "$v2dir/$id-attack.png" ] && shipped+=("$id"); done
    [ ${#shipped[@]} -eq 0 ] || { echo "already have v2 art, nothing to generate: ${shipped[*]}; drop them from the list" >&2; exit 1; }
  fi
  n=0
  for id in "${ids[@]}"; do
    if [ "$step" = 1 ] && [ $n -gt 0 ]; then
      echo "### pausing ${ENEMY_GEN_DELAY}s before the next enemy"; sleep "$ENEMY_GEN_DELAY" || exit 130
    fi
    n=$((n+1))
    echo "### [$n/${#ids[@]}] $id"
    "$0" "$id" "$step" "$@"; rc=$?
    [ $rc -eq 130 ] && { echo "interrupted at $id" >&2; exit 130; }
    # the first failure stops the batch; the rest is never started
    if [ $rc -ne 0 ]; then
      rest=("${ids[@]:$n}")
      echo "### $id failed (exit $rc); batch stopped after $((n-1))/${#ids[@]} ok.${rest[*]:+ Not started: ${rest[*]}}" >&2
      [ $rc -eq 3 ] && echo "### authentication recovery failed; follow the generator diagnostic above" >&2
      exit $rc
    fi
  done
  echo "### batch step $step: ${#ids[@]}/${#ids[@]} ok"
  exit 0
fi
id=${ids[0]}
: "${IMGGEN_STAGE:?set IMGGEN_STAGE in ~/.imggen.env}"
dir="$IMGGEN_STAGE/$id"
# STAGE/ID/ layout: raw/ (generated jpgs, prompts/, ID.log)  cutouts/ (cut work area: reports, rejected
# cutouts, check-green.png)  ID/ (accepted 1k cutouts only; this folder goes to the content repo)
# sheets/ (ID-status.png/.tsx, ID-attack.png/.tsx). Every file exists exactly once.
raw="$dir/raw"; acc="$dir/$id"
mkdir -p "$IMGGEN_STAGE"
# the 16 poses, in file-number order (NN = position); must match the generator and pack_enemy_sheets.py
POSES=(poison sleep stun silence burn freeze knockback taunt guard cover haste slow regen ko attack-thrust attack-lunge)
# what each pose shows, same order as POSES
POSE_PROMPTS=(
  "now sick with poison: body slumped, yellow-green venom dripping from the mouth, green stains on the body, both feet planted"
  "now asleep: slumped forward with eyes closed and head drooped, held item hanging loosely, no floor drawn"
  "now stunned: upright, head snapped to one side, eyes unfocused, three small yellow stars beside the head, one foot lifted, held item dangling"
  "now silenced: the free hand (or a paw) clamped over the closed mouth, eyes wide, held item low"
  "now burning: small flames licking the body and arms, flinching with arms wide and mouth open"
  "now frozen: rigid, a thin layer of pale blue rime and short icicles over the body and gear, keeping the original colors visible underneath, both feet planted"
  "knocked back: rocked back on the heels, one foot lifted, arms wide, mouth open in a pained grimace"
  "taunting: chest thrust forward, the held item raised high beside the head (or a fist if none), mouth wide in a jeer"
  "guarding: braced low, forearm raised across the face, held item across the body"
  "covering an ally: stepping sideways with the free arm thrown out wide to shield someone, held item ready"
  "hasted: mid-run, one knee lifted high, leaning forward, held item trailing behind"
  "slowed: heavy and weighed down, shoulders sagging, feet dragging, held item lowered"
  "regenerating: one hand pressed to the chest over a small gold-white mended patch, calm"
  "knocked out: lying on its side, limbs slack, eyes closed, held item on the ground by the hand; wide magenta margin on every side; do not add a floor"
  "a basic strike: a one-hand downward chop with the held item (or a claw swipe if none), weight forward"
  "a lunge: a wide step with the held item thrust toward the viewer's right, the other hand back for balance"
)
FRAME="Full body in frame with clear space around the extremities"
FIELD="Flat pure magenta background to every edge; no outline, border, or sticker edge around the figure; no shadow, glow, or vignette."
# cutout.py's thresholds assume 1024x1024 renders
GEN_SIZE=1k; GEN_ASPECT_RATIO=1:1

# pose_index POSE -> 0-based position in POSES
pose_index() { local i; for i in "${!POSES[@]}"; do [ "${POSES[$i]}" = "$1" ] && { echo "$i"; return; }; done; return 1; }
# pose_file POSE -> path of the generated jpg (may not exist)
pose_file() { local i; i=$(pose_index "$1") || return 1; printf '%s/%s-%02d-%s.jpg' "$raw" "$id" $((i+1)) "$1"; }

# concept FIELD -> that field of this enemy's ENEMY_CONCEPTS row (2 = canonical design, 3 = keep-list)
concept() { awk -F'|' -v id="$id" -v f="$1" '$1 == id { print $f; exit }' "$ENEMY_CONCEPTS"; }

# gen_one OUT PROMPT_FILE [REF]: one image from the generator, two tries; QUALITY= passes through.
# Calls run one at a time and every call is followed by ENEMY_GEN_DELAY seconds of sleep (rate limits),
# except that the first call of a run does not wait for a previous one.
gen_calls=0
gen_one() {
  local try rc
  for try in 1 2; do
    [ $gen_calls -eq 0 ] || sleep "$ENEMY_GEN_DELAY"
    gen_calls=$((gen_calls+1))
    GEN_MODEL=$ENEMY_GEN_MODEL GEN_RESOLUTION=$GEN_SIZE GEN_ASPECT=$GEN_ASPECT_RATIO GEN_QUALITY=${QUALITY:-} \
      $ENEMY_GEN_CMD "$@"; rc=$?
    [ $rc -eq 0 ] && usable_jpg "$1" && return 0
    [ $rc -eq 3 ] && { rm -f "$1"; return 3; }   # generator already attempted authentication recovery
  done
  rm -f "$1"; return 1
}

# generate [POSE...]: ready.jpg (unless re-rolling poses with one present), then the poses one by one,
# each an edit seeded from ready.jpg. Prompts are kept in DIR/prompts/.
generate() {
  local name canon keep p i rc
  name=${id//_/ }; canon=$(concept 2); keep=$(concept 3)
  [ -n "$canon" ] && [ -n "$keep" ] || { echo "no concept for $id in $ENEMY_CONCEPTS" >&2; return 1; }
  mkdir -p "$raw/prompts"
  if [ $# -eq 0 ] || [ ! -s "$raw/ready.jpg" ]; then
    printf '%s' "A hand-painted full-body battle sprite of the $name, $canon. Exactly two arms and two legs. Paint it in a hand-painted item-icon style: dark contour, saturated color, brushed material highlights. $FRAME. $FIELD" > "$raw/prompts/ready.txt"
    echo "ready"
    QUALITY=low gen_one "$raw/ready.jpg" "$raw/prompts/ready.txt"; rc=$?
    [ $rc -eq 0 ] || { echo "canonical generation failed" >&2; return $rc; }
  fi
  local want=("$@"); [ $# -gt 0 ] || want=("${POSES[@]}")
  for p in "${want[@]}"; do
    i=$(pose_index "$p")
    printf '%s' "Keep this exact $name and the same hand-painted battler: $keep. Same proportions and paint. Change only the pose: ${POSE_PROMPTS[$i]}. Exactly two arms and two legs. $FRAME and the held item. $FIELD" > "$raw/prompts/$p.txt"
    echo "$p"
    gen_one "$(pose_file "$p")" "$raw/prompts/$p.txt" "$raw/ready.jpg"; rc=$?
    [ $rc -eq 3 ] && { echo "  $p: authentication recovery failed; stopping (resolve the diagnostic above, then re-roll the missing poses)" >&2; return 3; }
    [ $rc -eq 0 ] || echo "  $p failed" >&2
  done
  echo "generated $(compgen -G "$raw/$id-*.jpg" | wc -l)/16 poses + ready.jpg in $dir"
}

# check_poses POSE... : every named pose must be a known name (aborts with the valid list otherwise)
check_poses() {
  local p
  for p in "$@"; do
    pose_file "$p" >/dev/null || { echo "unknown pose '$p'; poses: ${POSES[*]}" >&2; return 1; }
  done
}

# usable_jpg FILE: exists, readable header, and ends in the JPEG end-of-image marker FF D9.
# ImageMagick decodes a truncated download with exit 0 (grey fill), even with -regard-warnings,
# so the end marker is the only reliable truncation test.
usable_jpg() {
  [ -s "$1" ] && [ "$(tail -c2 "$1" | od -An -tx1 | tr -d ' \n')" = ffd9 ] && magick identify "$1" >/dev/null 2>&1
}

# cut_one JPG: one cutout, run by xargs; the report's last line is OK or a FAIL
cut_one() {
  local n; n=$(basename "${1%.*}")
  python3 -I "$root/scripts/cutout.py" "$1" "$dir/cutouts/$n.png" > "$dir/cutouts/$n.report.txt" 2>&1
  return 0
}

step1() {
  : "${ENEMY_GEN_CMD:?set ENEMY_GEN_CMD in ~/.imggen.env}" "${ENEMY_GEN_MODEL:?set ENEMY_GEN_MODEL in ~/.imggen.env}" "${ENEMY_CONCEPTS:?set ENEMY_CONCEPTS in ~/.imggen.env}"
  : "${ENEMY_GEN_DELAY:?set ENEMY_GEN_DELAY (seconds between generator calls) in ~/.imggen.env}"
  [[ $ENEMY_GEN_DELAY =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "ENEMY_GEN_DELAY must be a number of seconds, got '$ENEMY_GEN_DELAY'" >&2; return 1; }
  if [ $# -gt 0 ]; then
    check_poses "$@" || return 1
    [ -s "$raw/ready.jpg" ] || { echo "no $raw/ready.jpg to re-roll from; run: scripts/imggen $id 1" >&2; return 1; }
    echo "== 1 re-roll $id: $*"
    # set the current images aside (not .jpg, so the generator's count ignores them); a failed
    # request must not cost the image already paid for
    local p f; for p in "$@"; do f=$(pose_file "$p"); [ -e "$f" ] && mv -f "$f" "$f.prev"; done
    generate "$@"; local grc=$?
    local bad=()
    for p in "$@"; do
      f=$(pose_file "$p")
      if usable_jpg "$f"; then rm -f "$f.prev"
      else bad+=("$p"); [ -e "$f.prev" ] && mv -f "$f.prev" "$f"; fi
    done
    [ ${#bad[@]} -eq 0 ] || { echo "re-roll failed for: ${bad[*]} (previous image kept); retry: scripts/imggen $id 1 ${bad[*]}" >&2; [ $grc -eq 3 ] && return 3; return 1; }
    echo "next: review, then: scripts/imggen $id 2 $*"
    return
  fi
  if compgen -G "$raw/$id-*.jpg" >/dev/null; then
    echo "already generated: $dir (delete that folder to generate again, or re-roll poses: scripts/imggen $id 1 POSE...)" >&2; return 1
  fi
  echo "== 1 generate $id"
  generate; local grc=$?
  [ $grc -eq 3 ] && return 3
  [ $grc -eq 0 ] || return 1
  [ -s "$raw/ready.jpg" ] || { echo "generator left no ready.jpg" >&2; return 1; }
  local bad=() p; for p in "${POSES[@]}"; do usable_jpg "$(pose_file "$p")" || bad+=("$p"); done
  [ ${#bad[@]} -eq 0 ] || { echo "missing or unreadable poses: ${bad[*]}  (re-roll: scripts/imggen $id 1 ${bad[*]})" >&2; return 1; }
  echo "next: review the images in $raw, then: scripts/imggen $id 2"
}

# item_jpg ITEM -> source jpg of a pose or of ready
item_jpg() { if [ "$1" = ready ]; then printf '%s/ready.jpg' "$raw"; else pose_file "$1"; fi; }
# cut_name ITEM -> stem shared by its jpg, cutout png and report (ready | ID-NN-pose)
cut_name() { basename "$(item_jpg "$1")" .jpg; }
# cut_png ITEM -> its 1k cutout: in ID/ once accepted, otherwise in cutouts/
cut_png() {
  local n; n=$(cut_name "$1")
  if [ -e "$acc/$n.png" ]; then printf '%s/%s.png' "$acc" "$n"; else printf '%s/cutouts/%s.png' "$dir" "$n"; fi
}

# item_state ITEM -> ok | touched | stale | regen | fail | missing  (of its 1k cutout)
item_state() {
  local f n png rep
  f=$(item_jpg "$1"); n=$(cut_name "$1"); png=$(cut_png "$1"); rep="$dir/cutouts/$n.report.txt"
  if [ ! -s "$png" ]; then echo missing
  elif [ "$f" -nt "$png" ]; then echo stale                          # source re-rolled after the cut / touch-up
  elif [ ! -s "$rep" ] || [ "$png" -nt "$rep" ]; then echo touched   # edited by hand after the cut
  elif [ "$(tail -n1 "$rep")" = OK ]; then echo ok
  elif grep -q '^FAIL: REGENERATE' "$rep"; then echo regen
  else echo fail; fi
}

# sync_accepted: accepted cutouts (ok, touched) move to ID/, any other cutout back to cutouts/.
# mv keeps the mtime, so a touched-up cutout stays newer than its report.
sync_accepted() {
  local p n
  mkdir -p "$acc" "$dir/cutouts"
  for p in ready "${POSES[@]}"; do
    n=$(cut_name "$p")
    case $(item_state "$p") in
      ok|touched) [ -e "$dir/cutouts/$n.png" ] && [ ! -e "$acc/$n.png" ] && mv "$dir/cutouts/$n.png" "$acc/$n.png" ;;
      missing) ;;
      *) [ -e "$acc/$n.png" ] && mv -f "$acc/$n.png" "$dir/cutouts/$n.png" ;;
    esac
  done
  return 0
}

# migrate_layout: a stage made before raw/ ID/ sheets/ existed (jpgs, prompts/ and the log at the top,
# sheets plus a renamed copy of every cutout in export/ID/1k/) is moved into the current layout.
# A 1k copy identical to its cutout is dropped; one whose cutout is gone becomes that cutout;
# one that differs stays in export/ with a warning.
migrate_layout() {
  local f k p c moved=0
  mkdir -p "$raw"
  for f in "$dir"/*.jpg "$dir"/*.jpg.prev "$dir/$id.log" "$dir/prompts"; do
    [ -e "$f" ] || continue
    if [ -e "$raw/$(basename "$f")" ]; then echo "migrate: $f is also in raw/; left where it is" >&2; continue; fi
    mv "$f" "$raw/"; moved=1
  done
  local ex="$dir/export/$id"
  if [ -d "$ex" ]; then
    mkdir -p "$dir/cutouts"
    for f in "$ex/$id"-{status,attack}.{png,tsx}; do
      [ -e "$f" ] && { mkdir -p "$dir/sheets"; mv -f "$f" "$dir/sheets/"; moved=1; }
    done
    for k in "$ex"/1k/*.png; do
      [ -e "$k" ] || continue
      p=$(basename "$k" .png); p=${p//_/-}
      [ "$p" = ready ] || pose_index "$p" >/dev/null || continue
      c=$(cut_png "$p")
      if [ ! -e "$c" ]; then mv "$k" "$dir/cutouts/$(cut_name "$p").png"
      elif cmp -s "$k" "$c"; then rm -f "$k"
      else continue; fi
      moved=1
    done
    rmdir "$ex/1k" 2>/dev/null
  fi
  if [ -d "$dir/export" ]; then
    rmdir "$ex" "$dir/export" 2>/dev/null; [ -d "$dir/export" ] && echo "migrate: kept $dir/export (it holds files that differ from the cutouts)" >&2
  fi
  [ -d "$dir/cutouts" ] && sync_accepted
  [ $moved = 0 ] || echo "migrated $dir to raw/ cutouts/ $id/ sheets/"
}

step2() {
  [ -d "$dir" ] || { echo "nothing to cut out; run: scripts/imggen $id 1" >&2; return 1; }
  local pack=0 force=0 want=() p f n
  for p in "$@"; do
    case "$p" in
      pack) pack=1 ;;
      --force) force=1 ;;
      ready) want+=(ready) ;;
      *) pose_file "$p" >/dev/null || { echo "unknown pose '$p'; step 2 takes: ready ${POSES[*]}, pack, --force" >&2; return 1; }; want+=("$p") ;;
    esac
  done
  if [ $pack = 1 ] && { [ ${#want[@]} -gt 0 ] || [ $force = 1 ]; }; then
    echo "step 2 pack takes no poses or --force; it only rebuilds sheets from $dir/cutouts" >&2; return 1
  fi
  local items=(ready "${POSES[@]}")
  # sheets are rebuilt from scratch: a failed step 2 must leave nothing for step 3 to promote
  rm -rf "$dir/sheets"
  mkdir -p "$dir/cutouts" "$acc"
  if [ $pack = 1 ]; then
    echo "== 2 pack $id (from existing cutouts)"
    # stages cut before ready had its own cutout have none: cut just that one (no other cutout is touched)
    if [ "$(item_state ready)" = missing ] && usable_jpg "$raw/ready.jpg"; then
      echo "ready has no 1k cutout yet (older stage); cutting ready.jpg"
      export root dir; cut_one "$raw/ready.jpg"
    fi
  else
    [ ${#want[@]} -gt 0 ] || want=("${items[@]}")
    echo "== 2 cutout $id${*:+: $*}"
    # hand-edited cutouts are kept unless --force
    local cut=() kept=()
    for p in "${want[@]}"; do
      if [ $force = 0 ] && [ "$(item_state "$p")" = touched ]; then kept+=("$p"); else cut+=("$p"); fi
    done
    [ ${#kept[@]} -eq 0 ] || echo "keeping touched-up cutouts: ${kept[*]}  (re-cut them anyway: scripts/imggen $id 2 --force ${kept[*]})"
    # inputs first: a missing or truncated jpg is a generation problem, say so before cutting anything
    local gone=()
    for p in "${cut[@]}"; do usable_jpg "$(item_jpg "$p")" || gone+=("$p"); done
    if [ ${#gone[@]} -gt 0 ]; then
      echo "missing or unreadable images: ${gone[*]}" >&2
      echo "re-roll them: scripts/imggen $id 1 ${gone[*]}" >&2; return 1
    fi
    local files=()
    for p in "${cut[@]}"; do n=$(cut_name "$p"); rm -f "$dir/cutouts/$n".{png,report.txt} "$acc/$n.png"; files+=("$(item_jpg "$p")"); done
    if [ ${#files[@]} -gt 0 ]; then
      # cutouts are independent and ~1 core each; cap the fan-out so numpy's working set stays small
      local jobs; jobs=$(nproc 2>/dev/null || echo 2); [ "$jobs" -le 4 ] || jobs=4
      export -f cut_one; export root dir
      printf '%s\0' "${files[@]}" | xargs -0 -n1 -P "$jobs" bash -c 'cut_one "$0"'
    fi
  fi
  # accepted cutouts go to ID/, the rest stay in cutouts/; then judge every item, including earlier cuts
  sync_accepted
  local ok=0 touched=() bad=() stale=() regen=() st
  for p in "${items[@]}"; do
    st=$(item_state "$p")
    case "$st" in
      ok) ok=$((ok+1)) ;;
      touched) touched+=("$p") ;;
      stale) stale+=("$p"); bad+=("$p") ;;
      regen) regen+=("$p"); bad+=("$p") ;;
      *) bad+=("$p") ;;
    esac
  done
  echo "cutout: $ok ok, ${#touched[@]} touched up, ${#bad[@]} failed${touched[*]:+  (touched up: ${touched[*]})}"
  if [ ${#bad[@]} -gt 0 ]; then
    for p in "${bad[@]}"; do n=$(cut_name "$p"); echo "  FAIL $p ($(item_state "$p"))  $dir/cutouts/$n.report.txt"; done
    if [ ${#stale[@]} -gt 0 ]; then echo "  re-rolled since the last cut: ${stale[*]}  (re-cut: scripts/imggen $id 2 ${stale[*]})" >&2; fi
    if [ ${#regen[@]} -gt 0 ]; then echo "  render unusable (clipped or scenic), re-roll: scripts/imggen $id 1 ${regen[*]}" >&2; fi
    echo "no sheets built. Re-cut: scripts/imggen $id 2 ${bad[*]}   or accept/fix the failed cutouts in $dir/cutouts/ (save or touch them) and run: scripts/imggen $id 2 pack" >&2
    return 1
  fi
  magick montage "$acc/ready.png" "$acc/$id"-*.png -tile 4x -geometry 256x256+2+2 -background '#00ff40' "$dir/cutouts/check-green.png"
  echo "== 2 sheets $id"
  python3 -I "$root/scripts/pack_enemy_sheets.py" "$id" "$acc" "$dir/sheets" || return 1
  echo "review: $dir/cutouts/check-green.png and $dir/sheets/"
  echo "touch up: edit $acc/*.png, then: scripts/imggen $id 2 pack     promote: scripts/imggen $id 3"
}

step3() {
  [ -d "$dir/sheets" ] || { echo "no sheets to promote; run: scripts/imggen $id 2" >&2; return 1; }
  echo "== 3 promote $id"
  python3 -I "$root/scripts/promote_enemy_sheets.py" "$id" "$dir/sheets" || return 1
  echo "promoted; review git diff and commit"
}

if [ "$step" = 1 ]; then
  # an enemy that already has shipped v2 sheets is never generated again (no generator call, no work folder)
  if [ -e "$v2dir/$id-status.png" ] || [ -e "$v2dir/$id-attack.png" ]; then
    echo "$id already has v2 art in $v2dir; nothing to generate" >&2; exit 1
  fi
  mkdir -p "$dir"
elif [ ! -d "$dir" ]; then echo "no work folder $dir; run: scripts/imggen $id 1" >&2; exit 1; fi
migrate_layout
step$step "$@" 2>&1 | tee -a "$raw/$id.log"
exit "${PIPESTATUS[0]}"
