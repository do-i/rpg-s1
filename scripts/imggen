#!/usr/bin/env bash
# Enemy v2 battler art in three steps.
#   scripts/imggen ENEMY_ID 1 [POSE...]  generate poses from the image generator -> STAGE/ID/
#                                        with POSE names: re-roll just those poses
#   scripts/imggen ENEMY_ID 2 [--force] [POSE...]
#                                        cutout + 256px sheets (review the result) -> STAGE/ID/export/
#                                        with POSE names (or ready): re-cut just those, reuse the other cutouts
#   scripts/imggen ENEMY_ID 2 pack       sheets only, from the existing 1k cutouts; nothing is re-cut
# Touch-ups: edit the 1k cutouts in STAGE/ID/cutouts/ (ready.png, ID-NN-<pose>.png), then run step 2 pack.
# A cutout saved after its report is "touched up": step 2 accepts it even if its cut had failed,
# and never re-cuts it unless --force is given (a re-rolled jpg still marks it stale).
#   scripts/imggen ENEMY_ID 3            promote sheets into v2/ + ledger rows (no commit)
# Settings come from ~/.imggen.env (or the environment):
#   IMGGEN_STAGE   work area; each enemy gets STAGE/ID/
#   ENEMY_GEN_CMD  generator, called as: $ENEMY_GEN_CMD ID DIR   (needs DIR/ready.jpg + DIR/ID-NN-<pose>.jpg)
# Output of every step is also appended to STAGE/ID/ID.log.
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# config file supplies defaults; variables already set in the environment win
_stage=${IMGGEN_STAGE:-}; _gen=${ENEMY_GEN_CMD:-}
[ -f "$HOME/.imggen.env" ] && . "$HOME/.imggen.env"
[ -n "$_stage" ] && IMGGEN_STAGE=$_stage
[ -n "$_gen" ] && ENEMY_GEN_CMD=$_gen
id=${1:-}; step=${2:-}
case "$step" in 1|2|3) ;; *) echo "usage: scripts/imggen ENEMY_ID {1|2|3} [POSE...]   (1 generate, 2 cutout+sheets, 3 promote)" >&2; exit 2;; esac
[ -n "$id" ] || { echo "missing ENEMY_ID" >&2; exit 2; }
shift 2
: "${IMGGEN_STAGE:?set IMGGEN_STAGE in ~/.imggen.env}"
dir="$IMGGEN_STAGE/$id"
mkdir -p "$IMGGEN_STAGE"
# the 16 poses, in file-number order (NN = position); must match the generator and pack_enemy_sheets.py
POSES=(poison sleep stun silence burn freeze knockback taunt guard cover haste slow regen ko attack-thrust attack-lunge)

# pose_file POSE -> path of the generated jpg (may not exist)
pose_file() { local i; for i in "${!POSES[@]}"; do [ "${POSES[$i]}" = "$1" ] && { printf '%s/%s-%02d-%s.jpg' "$dir" "$id" $((i+1)) "$1"; return; }; done; return 1; }

# check_poses POSE... : every named pose must be a known name (aborts with the valid list otherwise)
check_poses() {
  local p
  for p in "$@"; do
    pose_file "$p" >/dev/null || { echo "unknown pose '$p'; poses: ${POSES[*]}" >&2; return 1; }
  done
}

# usable_jpg FILE: exists, readable header, and ends in the JPEG end-of-image marker FF D9.
# ImageMagick decodes a truncated download with exit 0 (grey fill), even with -regard-warnings,
# so the end marker is the only reliable truncation test.
usable_jpg() {
  [ -s "$1" ] && [ "$(tail -c2 "$1" | od -An -tx1 | tr -d ' \n')" = ffd9 ] && magick identify "$1" >/dev/null 2>&1
}

# cut_one JPG: one cutout, run by xargs; the report's last line is OK or a FAIL
cut_one() {
  local n; n=$(basename "${1%.*}")
  python3 -I "$root/scripts/cutout.py" "$1" "$dir/cutouts/$n.png" > "$dir/cutouts/$n.report.txt" 2>&1
  return 0
}

step1() {
  : "${ENEMY_GEN_CMD:?set ENEMY_GEN_CMD in ~/.imggen.env}"
  if [ $# -gt 0 ]; then
    check_poses "$@" || return 1
    [ -s "$dir/ready.jpg" ] || { echo "no $dir/ready.jpg to re-roll from; run: scripts/imggen $id 1" >&2; return 1; }
    echo "== 1 re-roll $id: $*"
    # set the current images aside (not .jpg, so the generator's count ignores them); a failed
    # request must not cost the image already paid for
    local p f; for p in "$@"; do f=$(pose_file "$p"); [ -e "$f" ] && mv -f "$f" "$f.prev"; done
    $ENEMY_GEN_CMD "$id" "$dir" "$@"
    local bad=()
    for p in "$@"; do
      f=$(pose_file "$p")
      if usable_jpg "$f"; then rm -f "$f.prev"
      else bad+=("$p"); [ -e "$f.prev" ] && mv -f "$f.prev" "$f"; fi
    done
    [ ${#bad[@]} -eq 0 ] || { echo "re-roll failed for: ${bad[*]} (previous image kept); retry: scripts/imggen $id 1 ${bad[*]}" >&2; return 1; }
    echo "next: review, then: scripts/imggen $id 2 $*"
    return
  fi
  if compgen -G "$dir/$id-*.jpg" >/dev/null; then
    echo "already generated: $dir (delete that folder to generate again, or re-roll poses: scripts/imggen $id 1 POSE...)" >&2; return 1
  fi
  echo "== 1 generate $id"
  $ENEMY_GEN_CMD "$id" "$dir" || return 1
  [ -s "$dir/ready.jpg" ] || { echo "generator left no ready.jpg" >&2; return 1; }
  local bad=() p; for p in "${POSES[@]}"; do usable_jpg "$(pose_file "$p")" || bad+=("$p"); done
  [ ${#bad[@]} -eq 0 ] || echo "missing or unreadable poses: ${bad[*]}  (re-roll: scripts/imggen $id 1 ${bad[*]})" >&2
  echo "next: review the images in $dir, then: scripts/imggen $id 2"
}

# item_jpg ITEM -> source jpg of a pose or of ready
item_jpg() { if [ "$1" = ready ]; then printf '%s/ready.jpg' "$dir"; else pose_file "$1"; fi; }

# item_state ITEM -> ok | touched | stale | regen | fail | missing  (of its 1k cutout)
item_state() {
  local f n png rep
  f=$(item_jpg "$1"); n=$(basename "$f" .jpg); png="$dir/cutouts/$n.png"; rep="$dir/cutouts/$n.report.txt"
  if [ ! -s "$png" ]; then echo missing
  elif [ "$f" -nt "$png" ]; then echo stale                          # source re-rolled after the cut / touch-up
  elif [ ! -s "$rep" ] || [ "$png" -nt "$rep" ]; then echo touched   # edited by hand after the cut
  elif [ "$(tail -n1 "$rep")" = OK ]; then echo ok
  elif grep -q '^FAIL: REGENERATE' "$rep"; then echo regen
  else echo fail; fi
}

step2() {
  [ -d "$dir" ] || { echo "nothing to cut out; run: scripts/imggen $id 1" >&2; return 1; }
  local pack=0 force=0 want=() p f n
  for p in "$@"; do
    case "$p" in
      pack) pack=1 ;;
      --force) force=1 ;;
      ready) want+=(ready) ;;
      *) pose_file "$p" >/dev/null || { echo "unknown pose '$p'; step 2 takes: ready ${POSES[*]}, pack, --force" >&2; return 1; }; want+=("$p") ;;
    esac
  done
  if [ $pack = 1 ] && { [ ${#want[@]} -gt 0 ] || [ $force = 1 ]; }; then
    echo "step 2 pack takes no poses or --force; it only rebuilds sheets from $dir/cutouts" >&2; return 1
  fi
  local items=(ready "${POSES[@]}")
  rm -rf "$dir/export"
  mkdir -p "$dir/cutouts"
  if [ $pack = 1 ]; then
    echo "== 2 pack $id (from existing cutouts)"
  else
    [ ${#want[@]} -gt 0 ] || want=("${items[@]}")
    echo "== 2 cutout $id${*:+: $*}"
    # hand-edited cutouts are kept unless --force
    local cut=() kept=()
    for p in "${want[@]}"; do
      if [ $force = 0 ] && [ "$(item_state "$p")" = touched ]; then kept+=("$p"); else cut+=("$p"); fi
    done
    [ ${#kept[@]} -eq 0 ] || echo "keeping touched-up cutouts: ${kept[*]}  (re-cut them anyway: scripts/imggen $id 2 --force ${kept[*]})"
    # inputs first: a missing or truncated jpg is a generation problem, say so before cutting anything
    local gone=()
    for p in "${cut[@]}"; do usable_jpg "$(item_jpg "$p")" || gone+=("$p"); done
    if [ ${#gone[@]} -gt 0 ]; then
      echo "missing or unreadable images: ${gone[*]}" >&2
      echo "re-roll them: scripts/imggen $id 1 ${gone[*]}" >&2; return 1
    fi
    local files=()
    for p in "${cut[@]}"; do f=$(item_jpg "$p"); rm -f "$dir/cutouts/$(basename "$f" .jpg)".{png,report.txt}; files+=("$f"); done
    if [ ${#files[@]} -gt 0 ]; then
      # cutouts are independent and ~1 core each; cap the fan-out so numpy's working set stays small
      local jobs; jobs=$(nproc 2>/dev/null || echo 2); [ "$jobs" -le 4 ] || jobs=4
      export -f cut_one; export root dir
      printf '%s\0' "${files[@]}" | xargs -0 -n1 -P "$jobs" bash -c 'cut_one "$0"'
    fi
  fi
  # judge every item, including ones cut in an earlier run
  local ok=0 touched=() bad=() stale=() regen=() st
  for p in "${items[@]}"; do
    st=$(item_state "$p")
    case "$st" in
      ok) ok=$((ok+1)) ;;
      touched) touched+=("$p") ;;
      stale) stale+=("$p"); bad+=("$p") ;;
      regen) regen+=("$p"); bad+=("$p") ;;
      *) bad+=("$p") ;;
    esac
  done
  echo "cutout: $ok ok, ${#touched[@]} touched up, ${#bad[@]} failed${touched[*]:+  (touched up: ${touched[*]})}"
  if [ ${#bad[@]} -gt 0 ]; then
    for p in "${bad[@]}"; do n=$(basename "$(item_jpg "$p")" .jpg); echo "  FAIL $p ($(item_state "$p"))  $dir/cutouts/$n.report.txt"; done
    if [ ${#stale[@]} -gt 0 ]; then echo "  re-rolled since the last cut: ${stale[*]}  (re-cut: scripts/imggen $id 2 ${stale[*]})" >&2; fi
    if [ ${#regen[@]} -gt 0 ]; then echo "  render unusable (clipped or scenic), re-roll: scripts/imggen $id 1 ${regen[*]}" >&2; fi
    echo "no sheets built. Re-cut: scripts/imggen $id 2 ${bad[*]}   or fix the 1k cutouts by hand in $dir/cutouts/ and run: scripts/imggen $id 2 pack" >&2
    return 1
  fi
  magick montage "$dir/cutouts/ready.png" "$dir"/cutouts/"$id"-*.png -tile 4x -geometry 256x256+2+2 -background '#00ff40' "$dir/cutouts/check-green.png"
  echo "== 2 sheets $id"
  python3 -I "$root/scripts/pack_enemy_sheets.py" "$id" "$dir" --ready "$dir/cutouts/ready.png" || return 1
  echo "review: $dir/cutouts/check-green.png and $dir/export/$id/"
  echo "touch up: edit $dir/cutouts/*.png, then: scripts/imggen $id 2 pack     promote: scripts/imggen $id 3"
}

step3() {
  [ -d "$dir/export/$id" ] || { echo "no sheets to promote; run: scripts/imggen $id 2" >&2; return 1; }
  echo "== 3 promote $id"
  python3 -I "$root/scripts/promote_enemy_sheets.py" "$id" "$dir/export" || return 1
  echo "promoted; review git diff and commit"
}

if [ "$step" = 1 ]; then mkdir -p "$dir"; elif [ ! -d "$dir" ]; then echo "no work folder $dir; run: scripts/imggen $id 1" >&2; exit 1; fi
step$step "$@" 2>&1 | tee -a "$dir/$id.log"
exit "${PIPESTATUS[0]}"
