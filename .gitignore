*.tiled-session
/target/
/target

# Release staging: release.yml builds the tarball here, and so does a local
# rehearsal of that step.
/dist/

# Local work-in-progress planning documents.
/plans/

# Scratch: run evidence screenshots and save-file backups kept out of history.
/temp/

# Derived output from the map editor (tools/map_editor) and from Tiled. Existing tracked
# source backups remain tracked; newly generated backups and thumbnails do not.
*.tmx.bak
/assets/scenarios/*/.cache/

# The map editor's Python environment and bytecode. Its dependencies are declared in
# tools/requirements.txt and installed by scripts/map-editor.sh setup.
/tools/.venv/
__pycache__/
